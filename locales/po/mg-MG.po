msgstr "Tsy manana alalana hanatanteraka ity baiko ity ianao."

#: controllers/nagios.php
msgid "Remote Commands must be enabled under console->Settings->NPC"
msgstr "Tsy maintsy alefa ao amin'ny console->Fandrindrana->NPC ny Baiko lavitra"

#: controllers/nagios.php
