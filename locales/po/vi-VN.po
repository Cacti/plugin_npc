msgstr "URL Nagios"

#: setup.php
msgid "The full URL to your Nagios installation (http://nagios.company.com/nagios/)"
msgstr "URL đầy đủ đến cài đặt Nagios của bạn (http://nagios.company.com/nagios/)"

#: setup.php
msgid "Date Format"
msgstr "Định dạng ngày"

#: setup.php
msgid "Select the format you want for displaying dates."
msgstr "Chọn định dạng bạn muốn để hiển thị ngày tháng."

#: setup.php
msgid "Time Format"
msgstr "Định dạng thời gian"

#: setup.php
msgid "Select the format you want for displaying times."
msgstr "Chọn định dạng bạn muốn để hiển thị thời gian."

#: setup.php
msgid "Portlet Refresh Rate"
msgstr "Tốc độ làm mới Portlet"

#: setup.php
msgid "The amount of time in seconds to wait before the portlets refresh. The minimum is 30 seconds."
msgstr "Khoảng thời gian tính bằng giây để đợi trước khi các portlet làm mới. Tối thiểu là 30 giây."

#: setup.php
msgid "Host/Service Config Type"
msgstr "Loại cấu hình máy chủ / dịch vụ"

#: setup.php
msgid "The config type is based on whether or not you are restoring retained information when Nagios starts. If you are unsure just leave the default value. If you can see host and service groups but not hosts or services try changing this setting."
msgstr "Loại cấu hình dựa trên việc bạn có đang khôi phục thông tin được giữ lại khi Nagios khởi động hay không. Nếu bạn không chắc chắn chỉ cần để lại giá trị mặc định. Nếu bạn có thể thấy máy chủ và nhóm dịch vụ nhưng không thấy máy chủ hoặc dịch vụ, hãy thử thay đổi cài đặt này."

#: setup.php
msgid "Host Icons"
msgstr "Biểu tượng máy chủ"

#: setup.php
msgid "Enable displaying host icons in the hosts grid. The icon_image and icon_image_alt parameters of the Nagios host definition are used to set the image. Icons should be 16x16 to get the best look. this setting does not affect the host status icons."
msgstr "Cho phép hiển thị biểu tượng máy chủ trong lưới máy chủ. Các thông số icon_image và icon_image_alt của định nghĩa máy chủ Nagios được sử dụng để thiết lập hình ảnh. Biểu tượng phải là 16x16 để có giao diện đẹp nhất. cài đặt này không ảnh hưởng đến các biểu tượng trạng thái máy chủ."

#: setup.php
msgid "Service Icons"
msgstr "Biểu tượng dịch vụ"

#: setup.php
msgid "Enable displaying service icons in the services grid. The icon_image and icon_image_alt parameters of the Nagios service definition are used to set the image. Icons should be 16x16 to get the best look. This setting does not affect the service status icons."
msgstr "Cho phép hiển thị các biểu tượng dịch vụ trong lưới dịch vụ. Các tham số icon_image và icon_image_alt của định nghĩa dịch vụ Nagios được sử dụng để thiết lập hình ảnh. Biểu tượng phải là 16x16 để có giao diện đẹp nhất. Cài đặt này không ảnh hưởng đến các biểu tượng trạng thái dịch vụ."

#: setup.php
msgid "Logging"
msgstr "Đăng nhập"

#: setup.php
msgid "Logging Level"
msgstr "Mức độ ghi nhật ký"

#: setup.php
msgid "The level of detail you want sent to the Cacti log file. WARNING: Leaving in DEBUG will quickly fill the cacti log."
msgstr "Mức độ chi tiết bạn muốn được gửi đến tệp nhật ký Cacti. CẢNH BÁO: Để lại trong DEBUG sẽ nhanh chóng lấp đầy nhật ký xương rồng."

