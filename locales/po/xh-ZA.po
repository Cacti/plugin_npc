#: setup.php
msgid "ERROR - Log errors only"
msgstr "IMPAZAMO - Bhala iimpazamo kuphela"

#: setup.php
msgid "WARN  - Log errors and warnings"
msgstr "WARN  - Bhala iimpazamo nezilumkiso kwilog"

#: setup.php
msgid "INFO  - Log errors, warnings, and info messages"
msgstr "INFO  - Bhala kwi-log iimpazamo, izilumkiso, kunye nemiyalezo yolwazi"

#: setup.php
msgid "DEBUG - Log everything"
msgstr "DEBUG - Rekhoda yonke into"

#: setup.php
msgid "Nagios Host Mapping"
msgstr "Ulungelelwaniso lweHosti ye-Nagios"

#: setup.php
msgid "Select the Nagios host that maps to this host."
msgstr "Khetha ihosti ye-Nagios enxibelelana nale hosti."

#: setup.php
msgid "NPC"
msgstr "NPC"

#: setup.php
msgid "Status Detail"
msgstr "Iinkcukacha zoBume"

#: setup.php
msgid "Service / Host Information"
msgstr "Ulwazi lweNkonzo / lweHosti"

#: setup.php
msgid "Command Execution"
msgstr "Ukuqhutywa koMyalelo"

#: setup.php
msgid "General Settings"
msgstr "Useto Ngokubanzi"

#: setup.php
msgid "Remote Commands"
msgstr "Imiyalelo eKude"

#: setup.php
msgid "Allow commands to be written to the Nagios command file."
msgstr "Vumela imiyalelo ukuba ibhalwe kwifayile yemiyalelo ye-Nagios."

#: setup.php
msgid "Nagios Command File Path"
msgstr "Indlela yeFayile yoMyalelo we-Nagios"

#: setup.php
msgid "The path to the Nagios command file (nagios.cmd)."
msgstr "Umendo oya kwifayile yomyalelo we-Nagios (nagios.cmd)."

#: setup.php
msgid "Nagios URL"
msgstr "I-URL ye-Nagios"

#: setup.php
msgid "The full URL to your Nagios installation (http://nagios.company.com/nagios/)"
msgstr "I-URL epheleleyo eya kufakelo lwakho lwe-Nagios (http://nagios.company.com/nagios/)"

#: setup.php
msgid "Date Format"
msgstr "Ifomathi yoMhla"

#: setup.php
msgid "Select the format you want for displaying dates."
msgstr "Khetha ifomathi oyifunayo yokubonisa imihla."

#: setup.php
msgid "Time Format"
msgstr "Ifomathi yeXesha"

#: setup.php
msgid "Select the format you want for displaying times."
msgstr "Khetha ifomathi oyifunayo yokubonisa amaxesha."

#: setup.php
msgid "Portlet Refresh Rate"
msgstr "Izinga lokuHlaziya i-Portlet"

#: setup.php
msgid "The amount of time in seconds to wait before the portlets refresh. The minimum is 30 seconds."
msgstr "Ixesha ngemizuzwana lokulinda ngaphambi kokuba ii-portlet zihlaziye. Ubuncinci yimizuzwana engama-30."

#: setup.php
msgid "Host/Service Config Type"
msgstr "Uhlobo loQwalaselo lweHosti/lweNkonzo"

#: setup.php
msgid "The config type is based on whether or not you are restoring retained information when Nagios starts. If you are unsure just leave the default value. If you can see host and service groups but not hosts or services try changing this setting."
msgstr "Uhlobo lwe-config lusekelwe ekubeni uyabuyisela na ulwazi olugcinwe ngaphambili xa i-Nagios iqala. Ukuba awuqinisekanga shiya nje ixabiso elingagqibekanga. Ukuba ubona amaqela eehosti neenkonzo kodwa ungaboni iihosti okanye iinkonzo zama ukutshintsha le setingi."

#: setup.php
msgid "Host Icons"
msgstr "Ii-ayikhoni zeHosti"

#: setup.php
msgid "Enable displaying host icons in the hosts grid. The icon_image and icon_image_alt parameters of the Nagios host definition are used to set the image. Icons should be 16x16 to get the best look. this setting does not affect the host status icons."
msgstr "Vula ukubonisa ii-ayikhoni zehosti kwigridi yeehosti. Iiparamitha ze-icon_image kunye ne-icon_image_alt zenkcazo yehosti ye-Nagios zisetyenziselwa ukuseta umfanekiso. Ii-ayikhoni kufuneka zibe yi-16x16 ukuze zibonakale kakuhle. Le setingi ayichaphazeli ii-ayikhoni zobume behosti."

#: setup.php
msgid "Service Icons"
msgstr "Ii-ayikhoni zeNkonzo"

#: setup.php
msgid "Enable displaying service icons in the services grid. The icon_image and icon_image_alt parameters of the Nagios service definition are used to set the image. Icons should be 16x16 to get the best look. This setting does not affect the service status icons."
msgstr "Vula ukubonisa ii-ayikhoni zenkonzo kwigridi yeenkonzo. Iiparamitha ze-icon_image kunye ne-icon_image_alt zenkcazo yenkonzo ye-Nagios zisetyenziselwa ukuseta umfanekiso. Ii-ayikhoni kufuneka zibe yi-16x16 ukuze zibonakale kakuhle. Le setingi ayichaphazeli ii-ayikhoni zobume benkonzo."

#: setup.php
msgid "Logging"
msgstr "Ukugcinwa kweeLog"

#: setup.php
msgid "Logging Level"
msgstr "Inqanaba lokuRekhoda"

#: setup.php
msgid "The level of detail you want sent to the Cacti log file. WARNING: Leaving in DEBUG will quickly fill the cacti log."
msgstr "Inqanaba leenkcukacha ofuna zithunyelwe kwifayile yelog ye-Cacti. ISILUMKISO: Ukuyishiya ikwi-DEBUG kuya kuyizalisa ngokukhawuleza ilog ye-Cacti."

