msgstr "イベントログ"

#: controllers/layout.php
msgid "Process Info"
msgstr "プロセス情報"

#: controllers/nagios.php
msgid "You do not have permission to execute this command."
msgstr "このコマンドを実行する権限がありません。"

#: controllers/nagios.php
msgid "Remote Commands must be enabled under console->Settings->NPC"
msgstr "リモートコマンドは、コンソール->設定-> NPCで有効にする必要があります"

#: controllers/nagios.php
msgid "The Nagios Command File Path must be set under console->Settings->NPC"
msgstr "Nagiosコマンドファイルパスは、コンソール->設定-> NPCで設定する必要があります"

#: controllers/nagios.php
msgid "Service Check Execution Time"
msgstr "サービスチェックの実行時間"

#: controllers/nagios.php
msgid "Service Check Latency"
msgstr "サービスチェックの待ち時間"

#: controllers/nagios.php
msgid "Host Check Execution Time"
msgstr "ホストチェックの実行時間"

#: controllers/nagios.php
msgid "Host Check Latency"
msgstr "ホストチェックの待ち時間"

#: controllers/services.php
msgid "Host Groups"
msgstr "ホストグループ"

#: npc.php
msgid "Invalid module requested."
msgstr "無効なモジュールがリクエストされました。"

#: npc.php
msgid "Invalid action requested."
msgstr "無効なアクションがリクエストされました。"

#: npc.php
msgid "This action requires a POST request."
msgstr "この操作には POST リクエストが必要です。"

#: npc.php
msgid "Controller not found."
msgstr "コントローラーが見つかりません。"

#: setup.php
msgid "ERROR - Log errors only"
msgstr "エラー-ログエラーのみ"

#: setup.php
msgid "WARN  - Log errors and warnings"
msgstr "警告-エラーと警告をログに記録します"

#: setup.php
msgid "INFO  - Log errors, warnings, and info messages"
msgstr "INFO-エラー、警告、および情報メッセージをログに記録します"

#: setup.php
msgid "DEBUG - Log everything"
msgstr "デバッグ-すべてをログに記録する"

#: setup.php
msgid "Nagios Host Mapping"
msgstr "Nagiosホストマッピング"

#: setup.php
msgid "Select the Nagios host that maps to this host."
msgstr "このホストにマップするNagiosホストを選択します。"

#: setup.php
msgid "NPC"
msgstr "NPC"

#: setup.php
msgid "Status Detail"
msgstr "ステータスの詳細"

#: setup.php
msgid "Service / Host Information"
msgstr "サービス/ホスト情報"

#: setup.php
msgid "Command Execution"
msgstr "コマンドの実行"

#: setup.php
msgid "General Settings"
msgstr "一般設定"

#: setup.php
msgid "Remote Commands"
msgstr "リモートコマンド"

#: setup.php
msgid "Allow commands to be written to the Nagios command file."
msgstr "コマンドをNagiosコマンドファイルに書き込むことを許可します。"

#: setup.php
msgid "Nagios Command File Path"
msgstr "Nagiosコマンドファイルパス"

#: setup.php
msgid "The path to the Nagios command file (nagios.cmd)."
msgstr "Nagiosコマンドファイル（nagios.cmd）へのパス。"

#: setup.php
msgid "Nagios URL"
msgstr "NagiosのURL"

#: setup.php
msgid "The full URL to your Nagios installation (http://nagios.company.com/nagios/)"
msgstr "Nagios インストール先の完全な URL (http://nagios.company.com/nagios/)"

#: setup.php
msgid "Date Format"
msgstr "日付フォーマット"

#: setup.php
msgid "Select the format you want for displaying dates."
msgstr "日付を表示する形式を選択します。"

#: setup.php
msgid "Time Format"
msgstr "時間の書式"

#: setup.php
msgid "Select the format you want for displaying times."
msgstr "時間を表示する形式を選択します。"

#: setup.php
msgid "Portlet Refresh Rate"
msgstr "ポートレットのリフレッシュレート"

#: setup.php
msgid "The amount of time in seconds to wait before the portlets refresh. The minimum is 30 seconds."
msgstr "ポートレットが更新されるまで待機する時間（秒単位）。最小は30秒です。"

#: setup.php
msgid "Host/Service Config Type"
msgstr "ホスト/サービス構成タイプ"

#: setup.php
msgid "The config type is based on whether or not you are restoring retained information when Nagios starts. If you are unsure just leave the default value. If you can see host and service groups but not hosts or services try changing this setting."
msgstr "設定タイプは、Nagiosの起動時に保持されている情報を復元するかどうかに基づいています。よくわからない場合は、デフォルト値のままにしてください。ホストとサービスグループは表示されるが、ホストまたはサービスは表示されない場合は、この設定を変更してみてください。"

#: setup.php
msgid "Host Icons"
msgstr "ホストアイコン"

#: setup.php
msgid "Enable displaying host icons in the hosts grid. The icon_image and icon_image_alt parameters of the Nagios host definition are used to set the image. Icons should be 16x16 to get the best look. this setting does not affect the host status icons."
msgstr "ホストグリッドでのホストアイコンの表示を有効にします。 Nagiosホスト定義のicon_imageおよびicon_image_altパラメーターは、イメージを設定するために使用されます。見栄えを良くするには、アイコンを16x16にする必要があります。この設定は、ホストステータスアイコンには影響しません。"

#: setup.php
msgid "Service Icons"
msgstr "サービスアイコン"

#: setup.php
msgid "Enable displaying service icons in the services grid. The icon_image and icon_image_alt parameters of the Nagios service definition are used to set the image. Icons should be 16x16 to get the best look. This setting does not affect the service status icons."
msgstr "サービスグリッドでのサービスアイコンの表示を有効にします。 Nagiosサービス定義のicon_imageおよびicon_image_altパラメーターは、画像を設定するために使用されます。見栄えを良くするには、アイコンを16x16にする必要があります。この設定は、サービスステータスアイコンには影響しません。"

#: setup.php
msgid "Logging"
msgstr "ログイン"

#: setup.php
msgid "Logging Level"
msgstr "ログレベル"

#: setup.php
msgid "The level of detail you want sent to the Cacti log file. WARNING: Leaving in DEBUG will quickly fill the cacti log."
msgstr "Cacti ログファイルに送信する詳細レベル。警告: DEBUG のままにすると、Cacti ログがすぐにいっぱいになります。"

#~ msgid "FATAL: Unable to make NPC Connection"
#~ msgstr "致命的：NPC接続を確立できません"
