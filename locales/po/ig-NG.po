msgid "NPC"
msgstr "NPC"

#: setup.php
msgid "Status Detail"
msgstr "Nkọwa Ọnọdụ"

#: setup.php
msgid "Service / Host Information"
msgstr "Ozi Ọrụ / Onye nnabata"

#: setup.php
msgid "Command Execution"
msgstr "Mmezu Iwu"

#: setup.php
msgid "General Settings"
msgstr "Ntọala Izugbe"

#: setup.php
msgid "Remote Commands"
msgstr "Iwu Dị N'ebe Dị Anya"

#: setup.php
msgid "Allow commands to be written to the Nagios command file."
msgstr "Kwe ka e dee iwu n'ime faịlụ iwu Nagios."

#: setup.php
msgid "Nagios Command File Path"
msgstr "Ụzọ Faịlụ Iwu Nagios"

#: setup.php
msgid "The path to the Nagios command file (nagios.cmd)."
msgstr "Ụzọ e si aga faịlụ iwu Nagios (nagios.cmd)."

#: setup.php
msgid "Nagios URL"
msgstr "URL Nagios"

#: setup.php
msgid "The full URL to your Nagios installation (http://nagios.company.com/nagios/)"
msgstr "URL zuru ezu maka nrụnye Nagios gị (http://nagios.company.com/nagios/)"

#: setup.php
msgid "Date Format"
msgstr "Ụdị Ụbọchị"

#: setup.php
msgid "Select the format you want for displaying dates."
msgstr "Họrọ usoro ị chọrọ maka igosipụta ụbọchị."

#: setup.php
msgid "Time Format"
msgstr "Ụdị Oge"

#: setup.php
msgid "Select the format you want for displaying times."
msgstr "Họrọ usoro ị chọrọ maka igosipụta oge."

#: setup.php
msgid "Portlet Refresh Rate"
msgstr "Ọnụego Mmelite Portlet"

#: setup.php
msgid "The amount of time in seconds to wait before the portlets refresh. The minimum is 30 seconds."
msgstr "Oge na sekọnd a ga-eche tupu portlet emeliteghachi. Nke kacha nta bụ sekọnd 30."

#: setup.php
msgid "Host/Service Config Type"
msgstr "Ụdị Nhazi Onye nnabata/Ọrụ"

#: setup.php
msgid "The config type is based on whether or not you are restoring retained information when Nagios starts. If you are unsure just leave the default value. If you can see host and service groups but not hosts or services try changing this setting."
msgstr "Ụdị nhazi ahụ dabere ma ị na-eweghachi ozi e chekwara mgbe Nagios malitere ma ọ bụ na ị naghị eweghachi. Ọ bụrụ na ị maghị nke ọma, hapụ uru ndabara. Ọ bụrụ na ị nwere ike ịhụ otu onye nnabata na ọrụ mana ị hụghị ndị nnabata ma ọ bụ ọrụ, nwaa ịgbanwe ntọala a."

#: setup.php
msgid "Host Icons"
msgstr "Akara Onye nnabata"

#: setup.php
msgid "Enable displaying host icons in the hosts grid. The icon_image and icon_image_alt parameters of the Nagios host definition are used to set the image. Icons should be 16x16 to get the best look. this setting does not affect the host status icons."
msgstr "Gbanye igosipụta akara ngosi onye nnabata na grid nke ndị nnabata. A na-eji paramita icon_image na icon_image_alt nke nkọwa onye nnabata Nagios setịpụ onyonyo ahụ. Akara ngosi kwesịrị ịbụ 16x16 iji mee ka ọ dị mma karịa. Ntọala a anaghị emetụta akara ngosi ọnọdụ onye nnabata."

#: setup.php
msgid "Service Icons"
msgstr "Akara Ngosi Ọrụ Gasị"

#: setup.php
msgid "Enable displaying service icons in the services grid. The icon_image and icon_image_alt parameters of the Nagios service definition are used to set the image. Icons should be 16x16 to get the best look. This setting does not affect the service status icons."
msgstr "Gbanye igosipụta akara ngosi ọrụ na grid nke ọrụ. A na-eji paramita icon_image na icon_image_alt nke nkọwa ọrụ Nagios setịpụ onyonyo ahụ. Akara ngosi kwesịrị ịbụ 16x16 iji mee ka ọ dị mma karịa. Ntọala a anaghị emetụta akara ngosi ọnọdụ ọrụ."

#: setup.php
msgid "Logging"
msgstr "Ndekọ"

#: setup.php
msgid "Logging Level"
msgstr "Ọkwa Ndekọ"

#: setup.php
msgid "The level of detail you want sent to the Cacti log file. WARNING: Leaving in DEBUG will quickly fill the cacti log."
msgstr "Ọkwa nkọwa ịchọrọ ka e ziga na faịlụ ndekọ Cacti. ỊDỌ AKA NÁ NTỊ: Ịhapụ ya na DEBUG ga-eju faịlụ ndekọ cacti ngwa ngwa."

