#: setup.php
msgid "ERROR - Log errors only"
msgstr "NJỌ - Dekọọ njọ naanị"

#: setup.php
msgid "WARN  - Log errors and warnings"
msgstr "ỊDỌ AKA NÁ NTỊ  - Debanye njehie na ịdọ aka ná ntị"

#: setup.php
msgid "INFO  - Log errors, warnings, and info messages"
msgstr "INFO  - Dekọọ mperi, ịdọ aka ná ntị, na ozi nkọwa"

#: setup.php
msgid "DEBUG - Log everything"
msgstr "DEBUG - Debanye ihe niile"

#: setup.php
msgid "Nagios Host Mapping"
msgstr "Nhazi Onye nnabata Nagios"

#: setup.php
msgid "Select the Nagios host that maps to this host."
msgstr "Họrọ onye nnabata Nagios nke kwekọrọ na onye nnabata a."

