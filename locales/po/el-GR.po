msgstr "Λεπτομέρεια κατάστασης"

#: setup.php
msgid "Service / Host Information"
msgstr "Πληροφορίες υπηρεσίας / κεντρικού υπολογιστή"

#: setup.php
msgid "Command Execution"
msgstr "Εκτέλεση εντολών"

#: setup.php
msgid "General Settings"
msgstr "Γενικές Ρυθμίσεις"

#: setup.php
msgid "Remote Commands"
msgstr "Απομακρυσμένες εντολές"

#: setup.php
msgid "Allow commands to be written to the Nagios command file."
msgstr "Να επιτρέπεται η εγγραφή εντολών στο αρχείο εντολών Nagios."

#: setup.php
msgid "Nagios Command File Path"
msgstr "Διαδρομή αρχείου εντολών Nagios"

#: setup.php
msgid "The path to the Nagios command file (nagios.cmd)."
msgstr "Η διαδρομή προς το αρχείο εντολών Nagios (nagios.cmd)."

#: setup.php
msgid "Nagios URL"
msgstr "Διεύθυνση URL Nagios"

#: setup.php
msgid "The full URL to your Nagios installation (http://nagios.company.com/nagios/)"
msgstr "Το πλήρες URL για την εγκατάσταση του Nagios (http://nagios.company.com/nagios/)"

#: setup.php
msgid "Date Format"
msgstr "Μορφή ημερομηνίας"

#: setup.php
msgid "Select the format you want for displaying dates."
msgstr "Επιλέξτε τη μορφή που θέλετε για εμφάνιση ημερομηνιών."

#: setup.php
msgid "Time Format"
msgstr "Μορφή ώρας"

#: setup.php
msgid "Select the format you want for displaying times."
msgstr "Επιλέξτε τη μορφή που θέλετε για την εμφάνιση των χρόνων."

#: setup.php
msgid "Portlet Refresh Rate"
msgstr "Ποσοστό ανανέωσης πύλης"

#: setup.php
msgid "The amount of time in seconds to wait before the portlets refresh. The minimum is 30 seconds."
msgstr "Ο χρόνος σε δευτερόλεπτα για να περιμένετε πριν από την ανανέωση των συστατικών στοιχείων πύλης. Το ελάχιστο είναι 30 δευτερόλεπτα."

#: setup.php
msgid "Host/Service Config Type"
msgstr "Τύπος διαμόρφωσης κεντρικού υπολογιστή / υπηρεσίας"

#: setup.php
msgid "The config type is based on whether or not you are restoring retained information when Nagios starts. If you are unsure just leave the default value. If you can see host and service groups but not hosts or services try changing this setting."
msgstr "Ο τύπος διαμόρφωσης βασίζεται στο κατά πόσον επαναφέρετε τις διατηρούμενες πληροφορίες κατά την εκκίνηση του Nagios. Εάν δεν είστε βέβαιοι απλώς αφήστε την προεπιλεγμένη τιμή. Εάν μπορείτε να δείτε ομάδες κεντρικών υπολογιστών και υπηρεσιών, αλλά όχι κεντρικούς υπολογιστές ή υπηρεσίες, δοκιμάστε να αλλάξετε αυτήν τη ρύθμιση."

#: setup.php
msgid "Host Icons"
msgstr "Εικονίδια κεντρικού υπολογιστή"

#: setup.php
msgid "Enable displaying host icons in the hosts grid. The icon_image and icon_image_alt parameters of the Nagios host definition are used to set the image. Icons should be 16x16 to get the best look. this setting does not affect the host status icons."
msgstr "Ενεργοποίηση εμφάνισης εικονιδίων κεντρικού υπολογιστή στο πλέγμα κεντρικών υπολογιστών. Οι παράμετροι icon_image και icon_image_alt του ορισμού κεντρικού υπολογιστή Nagios χρησιμοποιούνται για τη ρύθμιση της εικόνας. Τα εικονίδια πρέπει να είναι 16x16 για να έχετε την καλύτερη εμφάνιση. Αυτή η ρύθμιση δεν επηρεάζει τα εικονίδια κατάστασης κεντρικού υπολογιστή."

#: setup.php
msgid "Service Icons"
msgstr "Εικονίδια υπηρεσίας"

#: setup.php
msgid "Enable displaying service icons in the services grid. The icon_image and icon_image_alt parameters of the Nagios service definition are used to set the image. Icons should be 16x16 to get the best look. This setting does not affect the service status icons."
msgstr "Ενεργοποίηση εμφάνισης εικονιδίων υπηρεσίας στο πλέγμα υπηρεσιών. Οι παράμετροι icon_image και icon_image_alt του ορισμού υπηρεσίας Nagios χρησιμοποιούνται για τη ρύθμιση της εικόνας. Τα εικονίδια πρέπει να είναι 16x16 για να έχετε την καλύτερη εμφάνιση. Αυτή η ρύθμιση δεν επηρεάζει τα εικονίδια κατάστασης υπηρεσίας."

#: setup.php
msgid "Logging"
msgstr "Υλοτομία"

#: setup.php
msgid "Logging Level"
msgstr "Επίπεδο καταγραφής"

#: setup.php
msgid "The level of detail you want sent to the Cacti log file. WARNING: Leaving in DEBUG will quickly fill the cacti log."
msgstr "Το επίπεδο λεπτομέρειας που θέλετε να σταλεί στο αρχείο καταγραφής Cacti. ΠΡΟΕΙΔΟΠΟΙΗΣΗ: Η έξοδος στο DEBUG θα γεμίσει γρήγορα το αρχείο καταγραφής κάκτων."

